# Godot 4+ specific ignores
.godot/
*.tmp

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
*.import

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# .NET build artifacts (in case of non-default output paths)
bin/
obj/

# Editor/IDE settings (machine-specific)
.vscode/
.kiro/

# Test config (contains machine-specific Godot path)
test/test_config.json

# Git credentials
*.git-credentials
{
    "brackets": [
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "${", "close": "}" },
        { "open": "(", "close": ")" }
    ],
    "surroundingPairs": [
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"" }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*\\[node:",
            "end": "^(?=\\s*\\[node:)"
        }
    }
}
